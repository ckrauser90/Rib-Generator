# Sicherheits-Header für Cloudflare (Worker mit statischen Dateien liest diese Datei).
# Der Cloudflare-Build ergänzt die CSP in out/_headers mit Hashes der exportierten
# Next.js-Skripte (scripts/security-headers.mjs). Diese Basis-Header bleiben erhalten.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), payment=()
  X-Frame-Options: DENY
